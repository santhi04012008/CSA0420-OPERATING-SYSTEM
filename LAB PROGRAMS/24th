#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buffer[100];

    fd=open("sample.txt",O_CREAT|O_RDWR,0644);

    if(fd<0)
    {
        perror("File opening failed");
        return 1;
    }

    write(fd,"Hello UNIX",10);

    lseek(fd,0,SEEK_SET);

    read(fd,buffer,10);
    buffer[10]='\0';

    printf("File Content: %s\n",buffer);

    close(fd);

    printf("File closed successfully");

    return 0;
}
