#include <stdio.h>

int main()
{
    int b[20], p[20], a[20], nb, np, i, j, w;

    printf("Enter number of blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(i=0;i<nb;i++)
        scanf("%d", &b[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(i=0;i<np;i++)
        scanf("%d", &p[i]);

    for(i=0;i<np;i++)
    {
        w=-1;
        for(j=0;j<nb;j++)
        {
            if(b[j]>=p[i] && (w==-1 || b[j]>b[w]))
                w=j;
        }

        if(w!=-1)
        {
            a[i]=w;
            b[w]-=p[i];
        }
        else
            a[i]=-1;
    }

    printf("\nProcess\tSize\tBlock\n");
    for(i=0;i<np;i++)
    {
        printf("%d\t%d\t",i+1,p[i]);
        if(a[i]!=-1)
            printf("%d\n",a[i]+1);
        else
            printf("Not Allocated\n");
    }
    return 0;
}
