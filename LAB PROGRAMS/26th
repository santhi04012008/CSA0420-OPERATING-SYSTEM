#include <stdio.h>

int main()
{
    FILE *fp;
    char name[30], data[100];
    int ch;

    printf("1.Create\n2.Write\n3.Read\n");
    printf("Enter choice: ");
    scanf("%d",&ch);

    printf("Enter filename: ");
    scanf("%s",name);

    switch(ch)
    {
        case 1:
            fp=fopen(name,"w");
            printf("File created successfully");
            fclose(fp);
            break;

        case 2:
            fp=fopen(name,"w");
            printf("Enter content: ");
            scanf(" %[^\n]",data);
            fprintf(fp,"%s",data);
            fclose(fp);
            printf("File written successfully");
            break;

        case 3:
            fp=fopen(name,"r");
            if(fp==NULL)
            {
                printf("File not found");
                break;
            }
            while(fgets(data,sizeof(data),fp))
                printf("%s",data);
            fclose(fp);
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
