#include <stdio.h>

int main()
{
    int b[20],n,i;

    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers:\n");
    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("\nLinked File Allocation:\n");

    for(i=0;i<n;i++)
    {
        if(i<n-1)
            printf("%d -> %d\n",b[i],b[i+1]);
        else
            printf("%d -> NULL\n",b[i]);
    }

    printf("First Block: %d\n",b[0]);
    printf("Last Block: %d\n",b[n-1]);

    return 0;
}
