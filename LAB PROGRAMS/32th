#include <stdio.h>

int main()
{
    int p[30],f[10],time[10];
    int n,m,i,j,t=0,fault=0,hit,pos;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter page reference string:\n");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Enter number of frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++)
    {
        f[i]=-1;
        time[i]=0;
    }

    for(i=0;i<n;i++)
    {
        hit=0;

        for(j=0;j<m;j++)
        {
            if(f[j]==p[i])
            {
                hit=1;
                time[j]=++t;
                break;
            }
        }

        if(!hit)
        {
            pos=0;

            for(j=0;j<m;j++)
            {
                if(f[j]==-1)
                {
                    pos=j;
                    break;
                }

                if(time[j]<time[pos])
                    pos=j;
            }

            f[pos]=p[i];
            time[pos]=++t;
            fault++;
        }

        for(j=0;j<m;j++)
            printf("%d ",f[j]);

        printf("\n");
    }

    printf("Page Faults = %d",fault);

    return 0;
}
