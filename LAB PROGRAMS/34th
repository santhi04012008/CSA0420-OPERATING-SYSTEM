#include <stdio.h>

int main()
{
    int start,len,i;

    printf("Enter starting block: ");
    scanf("%d",&start);

    printf("Enter file length: ");
    scanf("%d",&len);

    printf("\nFile Allocation:\n");
    printf("Block\tFile\n");

    for(i=0;i<len;i++)
        printf("%d\t%d\n",start+i,i+1);

    return 0;
}
