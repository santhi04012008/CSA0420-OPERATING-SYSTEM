#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[30], word[30], line[200];

    printf("Enter filename: ");
    scanf("%s",filename);

    printf("Enter word to search: ");
    scanf("%s",word);

    fp=fopen(filename,"r");

    if(fp==NULL)
    {
        printf("File not found");
        return 1;
    }

    printf("\nMatching lines:\n");

    while(fgets(line,sizeof(line),fp))
    {
        if(strstr(line,word)!=NULL)
            printf("%s",line);
    }

    fclose(fp);

    return 0;
}
